# Sparse counter inside a long range — exercises extrapolatedRate.
# softprobe: counter

load 5m
  http_requests{job="api"} 0 50

eval instant at 1h rate(http_requests[1h])
  {job="api"} 0.020833333333333332

eval instant at 1h increase(http_requests[1h])
  {job="api"} 75
