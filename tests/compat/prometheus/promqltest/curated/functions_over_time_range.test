load 30s
  bar 0 1 10 100 1000

eval range from 0 to 2m step 1m sum_over_time(bar[30s])
  {} 0 11 1100

clear

load 30s
  bar 0 1 10 100 1000 0 0 0 0

eval range from 0 to 2m step 1m sum_over_time(bar[30s])
  {} 0 11 1100

clear

load 30s
  bar 5 17 42 2 7 905 51

eval range from 0 to 3m step 1m sum_over_time(bar[30s])
  {} 5 59 9 956
